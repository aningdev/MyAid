      "borderColor": "transparent"
    },
    "glass": {
      "backgroundColor": "oklch(from var(--card) l c h / 0.8)",
      "boxShadow": "none",
      "borderColor": "var(--border)",
      "backdropFilter": "blur(20px)"
    },
    "menu": {
