{
  "press": {
    "scale": 1
  },
  "dark": {
    "card": {
      "backgroundImage": "linear-gradient(180deg, var(--card) 0%, var(--card) 100%)",
      "boxShadow": "0 1px 3px 0 oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)"
    },
    "inset": {
      "boxShadow": "none"
    },
    "field": {
      "boxShadow": "0 1px 2px 0 oklch(0 0 0 / 0.05)"
    },
    "raised": {
      "backgroundColor": "var(--raised)",
      "backgroundImage": "linear-gradient(180deg, var(--raised) 0%, var(--raised) 100%)",
      "boxShadow": "0 1px 2px 0 oklch(0 0 0 / 0.05)",
      "borderColor": "transparent"
    },
    "hover": {
      "backgroundColor": "var(--hover)",
      "backgroundImage": "linear-gradient(180deg, var(--hover) 0%, var(--hover) 100%)",
      "boxShadow": "0 1px 2px 0 oklch(0 0 0 / 0.05)",
      "borderColor": "transparent"
    },
    "pressed": {
      "backgroundColor": "oklch(0.34846 0 0)",
      "backgroundImage": "linear-gradient(180deg, oklch(0.34846 0 0) 0%, oklch(0.34846 0 0) 100%)",
      "boxShadow": "none",
      "borderColor": "transparent"
    },
    "light": {
      "backgroundColor": "var(--primary)",
      "backgroundImage": "linear-gradient(180deg, var(--primary) 0%, var(--primary) 100%)",
      "boxShadow": "none",
      "borderColor": "transparent"
    },
    "accent": {
      "backgroundColor": "var(--primary)",
      "backgroundImage": "linear-gradient(180deg, var(--primary) 0%, var(--primary) 100%)",
      "boxShadow": "none",
      "borderColor": "transparent"
    },
    "track": {
      "boxShadow": "none",
      "borderColor": "var(--border)"
    },
    "fill": {
      "backgroundColor": "transparent",
      "backgroundImage": "linear-gradient(180deg, var(--primary) 0%, var(--primary) 100%)",
      "boxShadow": "none",
      "borderColor": "transparent"
    },
    "knob": {
      "backgroundColor": "var(--knob)",
