{
  "name": "dsh-bot",
  "id": "com.aningdev.dshbot",
  "version": "0.1.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "theme": "./theme.json",
  "resolve": {
    "conditions": ["node"],
    "alias": {
      "@": "./"
    }
  },
  "capabilities": {
    "application": true,
    "homeDir": true,
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "notifications": true,
    "network": {
      "http": [
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http"],
          "paths": ["/", "/status", "/connection", "/registration", "/bridge/devices"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["ws"],
          "paths": ["/watch"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["POST"],
          "schemes": ["http"],
          "paths": [
            "/dsh/start",
            "/dsh/stop",
            "/dsh/restart",
            "/registration/enable",
            "/registration/stop",
            "/bridge/pairing"
          ]
        },
        {
          "host": "127.0.0.1",
          "methods": ["DELETE"],
          "schemes": ["http"],
          "pathPrefixes": ["/bridge/devices/"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http"],
          "paths": ["/connect"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http", "ws"],
          "paths": ["/api/remote.mux"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["POST"],
          "schemes": ["http"],
          "pathPrefixes": ["/api"]
        }
      ]
    },
    "fs": {
      "read": ["${homeDir}/.dsh-bot", "${homeDir}/.dsh-bot-dev"],
      "write": ["${homeDir}/.dsh-bot", "${homeDir}/.dsh-bot-dev"]
    },
    "process": {
      "env": [
        "DSH_BOT_HOME",
        "DSH_BOT_HOST_PORT",
        "DSH_BOT_LOGIN_URL",
        "DSH_BOT_SMOKE_HOST",
        "DSH_BOT_PATCH"
      ],
      "execute": ["dsh-bot-host"]
    }
  }
}
