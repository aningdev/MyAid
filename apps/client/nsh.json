{
  "name": "MyAid",
  "id": "com.aningdev.myaid",
  "version": "0.1.0",
  "build": 1,
  "icon": "assets/icon.png",
  "rust": ".",
  "appearance": "system",
  "theme": "theme.json",
  "resolve": {
    "conditions": ["node"]
  },
  "capabilities": {
    "network": {
      "hosts": ["127.0.0.1", "picsum.photos"]
    },
    "fs": {
      "read": ["/"],
      "write": ["${homeDir}/.myaid", "${dataDir}"]
    },
    "process": {
      "env": ["MYAID_HOST_SOCKET", "MYAID_DSH_LOGIN_URL"],
      "execute": ["claude", "codex"]
    }
  }
}
