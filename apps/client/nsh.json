{
  "name": "MyAid",
  "id": "com.aningdev.myaid",
  "version": "0.1.0",
  "build": 1,
  "icon": "assets/icon.png",
  "appearance": "system",
  "theme": "theme.json",
  "resolve": {
    "conditions": ["node"]
  },
  "capabilities": {
    "clipboard": true,
    "picker": true,
    "notifications": true,
    "network": {
      "http": [
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http"],
          "paths": ["/", "/status", "/connection", "/registration"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["ws"],
          "paths": ["/watch"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http"],
          "paths": ["/v1/health"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["POST"],
          "schemes": ["http"],
          "paths": [
            "/dsh/start",
            "/dsh/stop",
            "/dsh/restart",
            "/registration/enable",
            "/registration/stop"
          ]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http"],
          "paths": ["/connect"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["GET"],
          "schemes": ["http", "ws"],
          "paths": ["/api/remote.mux"]
        },
        {
          "host": "127.0.0.1",
          "methods": ["POST"],
          "schemes": ["http"],
          "pathPrefixes": ["/api"]
        }
      ]
    },
    "fs": {
      "read": ["${homeDir}/.myaid", "${homeDir}/.myaid-dev"],
      "write": ["${homeDir}/.myaid", "${homeDir}/.myaid-dev"]
    },
    "process": {
      "env": [
        "MYAID_DATA_ROOT",
        "MYAID_HOST_PORT",
        "MYAID_RELAY_PORT",
        "MYAID_DSH_LOGIN_URL",
        "MYAID_SMOKE_HOST"
      ],
      "execute": ["myaid-host"]
    }
  }
}
