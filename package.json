{
  "name": "@myaid/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "typescript": "7.1.0-beta"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "bun run --cwd apps/client dev",
    "check": "vp check --fix && bun run --cwd packages/myaid-plugin-core check && bun run --cwd apps/client check && cargo check --workspace",
    "build": "bun run --cwd packages/myaid-plugin-core build && bun run --cwd apps/client build",
    "test": "cargo test --workspace && bun run --cwd packages/myaid-plugin-core test && bun run --cwd apps/client test",
    "host:dev": "cargo run --manifest-path apps/host/Cargo.toml -- serve-app"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "simple-git-hooks": "^2.13.1",
    "typescript": "catalog:",
    "vite-plus": "^1.4.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
