  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@deepseek-ai/cordis": "~4.1.0",
      "@deepseek-ai/cordis-plugin-include": "~1.1.0",
      "@deepseek-ai/schemastery": "~3.19.0",
      "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
      "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
      "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.5",
      "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
      "@deepseek-ai/dsh-api-settings-controller": "0.2.2-rc.5",
      "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
      "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.5",
      "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
      "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
      "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.5",
      "@deepseek-ai/dsh-client-store": "0.2.2-rc.5",
      "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
      "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
      "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
      "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
      "@deepseek-ai/dsh-host-directory-picker": "0.2.2-rc.5",
      "@deepseek-ai/dsh-host-plugin-inventory": "0.2.2-rc.5",
      "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
      "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.5",
      "@deepseek-ai/dsh-plugin-market": "0.2.2-rc.5",
      "@deepseek-ai/dsh-session": "0.2.2-rc.5",
      "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
      "@deepseek-ai/dsh-session-stats": "0.2.2-rc.5",
      "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
      "@deepseek-ai/dsh-session-turn-outline": "0.2.2-rc.5",
      "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
      "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
      "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
      "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
      "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
      "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
      "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5",
      "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
      "@types/node": "26.6.6",
      "shadcn-nsh": "0.8.0",
      "typescript": "7.1.0-beta",
      "zod": "4.6.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "fix": "vp check --fix && cargo fmt --all",
    "check": "node scripts/check-dsh-pin.mjs && node scripts/check-docs.mjs && vp check && vp run -F '@dsh-bot/*' -F 'dsh-*' -F '!@dsh-bot/workspace' check && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "build": "vp run --filter @dsh-bot/client... build",
    "test": "cargo test --workspace && vp run -F '@dsh-bot/*' -F 'dsh-*' -F '!@dsh-bot/workspace' test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "^1.5.0"
  }
}
