{
  "name": "@myaid/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "typescript": "7.1.0-beta"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "dev": "vp run @myaid/client#dev",
    "check": "vp check --fix && vp run @myaid/myaid-plugin-core#check && vp run @myaid/client#check && cargo check --workspace",
    "build": "vp run --filter @myaid/client... build",
    "test": "cargo test --workspace && vp run @myaid/myaid-plugin-core#test && vp run @myaid/client#test",
    "host:dev": "cargo run --manifest-path apps/host/Cargo.toml -- serve-app"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
