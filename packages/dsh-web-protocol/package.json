{
  "name": "@dsh-bot/dsh-web-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Client-only type re-exports of the official dsh web Remote/wire contracts the product imports (pinned through the workspace catalog). Plugins must not depend on this package.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./interaction": {
      "types": "./src/interaction.ts",
      "default": "./src/interaction.ts"
    },
    "./llm": {
      "types": "./src/llm.ts",
      "default": "./src/llm.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "default": "./src/plugins.ts"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "default": "./src/settings.ts"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "default": "./src/workspace.ts"
    },
    "./bot-presets": {
      "types": "./src/bot-presets.ts",
      "default": "./src/bot-presets.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-settings-controller": "catalog:",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:",
    "@deepseek-ai/dsh-api-workspace-files": "catalog:",
    "@deepseek-ai/dsh-attachment": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-host-directory-picker": "catalog:",
    "@deepseek-ai/dsh-host-plugin-inventory": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-plugin-manager": "catalog:",
    "@deepseek-ai/dsh-plugin-market": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-session-stats": "catalog:",
    "@deepseek-ai/dsh-session-turn-outline": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
