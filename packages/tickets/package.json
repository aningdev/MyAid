{
  "name": "dsh-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Tickets the Main Bot hands to a Bot, the Attention they raise, and their Remote.",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./remote": {
      "types": "./src/remote.ts",
      "default": "./src/remote.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:",
    "@types/node": "catalog:",
    "dsh-bots": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
