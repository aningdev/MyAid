{
  "name": "dsh-bots",
  "version": "0.1.0",
  "private": true,
  "description": "The product Registry and Main Bot, and the writable half of Bot Agent presets, exposed to every Device through the `bots` Remote.",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./remote": {
      "types": "./src/remote.ts",
      "default": "./src/remote.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "js-yaml": "^4.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
