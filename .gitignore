# Dependencies and build output
node_modules/
dist/
.build/
.cache/
coverage/
*.tsbuildinfo
*.log

# Local credentials and agent state
.env
.env.*
!.env.example
.pi/
.DS_Store
.nsh/
apps/client/launch.json
# Plugin build output: `vp pack` writes `lib/`, which `dev` / `check` / `test` and the Host
# overlay build when they need it (installed bundles ship it as JS: Node does not strip
# TypeScript under `node_modules`).
packages/*/lib/
# Generated by apps/client `prepare:sdk` (Node-condition dsh client bundle)
apps/client/lib/dsh/sdk.js
# Scratch Host root the real-Host smokes run against (`screens/*.smoke.test.tsx`).
.dsh-bot-smoke/
# Dev-only overlay `scripts/dev.mjs` writes for the Bot preset plugin.
.dev/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# TypeScript / bundler
*.tsbuildinfo
.npm
.eslintcache
.vite/
.turbo
# Vite+ hook dispatcher (recreated by `vp config` / `vp hooks enable`)
.vite-hooks/_

# pnpm / yarn
.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Generated by Cargo
debug
target
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt
.nsh/

# Generated by apps/client `prepare:sdk` from official ModuleLoader client bundles
apps/client/lib/dsh/generated/
